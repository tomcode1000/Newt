# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# OpenRouter API key (openrouter.ai/keys). Required for workers.
OPENROUTER_API_KEY=

# Model id on OpenRouter. Defaults to a free NVIDIA Nemotron model.
NEWT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# neatlogs PROJECT API key (not the nlw_ HTTP key). Optional: without it,
# Newt runs untraced. Check with: python -m neatlogs doctor --probe
NEATLOGS_API_KEY=

# Optional: DeepSeek's own API (platform.deepseek.com). Used when NEWT_MODEL
# is a deepseek-* id, e.g. NEWT_MODEL=deepseek-flash.
DEEPSEEK_API_KEY=
