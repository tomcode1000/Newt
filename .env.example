# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Anthropic API key (console.anthropic.com). Required for workers.
ANTHROPIC_API_KEY=

# neatlogs PROJECT API key (not the nlw_ HTTP key). Optional: without it,
# Newt runs untraced. Check with: python -m neatlogs doctor --probe
NEATLOGS_API_KEY=
